CRF_Gamemode CRF_Lobby1 : "{6A996BBFCEB37E78}Prefabs/MP/Modes/Lobby/CRF_Lobby.et" {
 coords 7260.9 383.086 7275.257
 EnableAIInGameState 1
 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTextData "The actions on ISLE FOX are a simultaneous, shaping operation in direct support of B CO, 1-36 IN’s push inland in Northern Germany. With the Sea of Japan and Sakhalin exchanges escalating into a broader NATO–Warsaw Pact confrontation, Soviet airlift and early-warning assets in the Baltic are extending the enemy’s ability to prosecute rapid counter-punches against NATO spearheads. Seizing ISLE FOX denies a forward radar/airfield node to the Soviets and interrupts Baltic sea lanes used for resupply and fast reaction elements — reducing detection and shortening the reaction window available to Warsaw Pact QRFs responding to the northern German salient."\
   ""\
   "BLUFOR Composition: Armored/Infantry/Mechanized/Etc.."\
   "BLUFOR Assets:"\
   "IFV"\
   "SNIPER"\
   "MORTAR"\
   ""\
   "OPFOR Composition: Armored/Infantry/Mechanized/Etc.."\
   "OPFOR Assets:"\
   ""\
   "Time:"\
   ""\
   "Weather:"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "OBJ GOLD - 50% Domination of the objective"\
   "OBJ EMERALD - 50% Domination of the objective"\
   "OBJ PLATINUM - Locate the enemy C2 Vehicle in the forest"\
   "OBJ GRANITE - Clear the port of all contact"
  }
 }
