$grp BaseGameTriggerEntity {
 Zone1 {
  coords 9644.794 131.84 10026.229
  userScript "	string m_sAttackKey = \"BLUFOR\";"\
  "	string m_sDefenderKey = \"OPFOR\";"\
  "	float percentToWin = 0.50;"\
  "	"\
  "	void PhaseWin()"\
  "	{"\
  "		SCR_PopUpNotification.GetInstance().PopupMsg(\"OBJ Gold is under our control!\", 10, \"Continue mission to the next objective!\");"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 100
  PeriodicQueries 1
  UpdatePeriod 10
  OnQueryFinished ""\
  "		QueryEntitiesInside();"\
  "		array<IEntity> entities = {};"\
  "		GetEntitiesInside(entities);"\
  "		int attackerCount = 0;"\
  "		int defenderCount = 0;"\
  "		foreach (IEntity entity: entities)"\
  "		{"\
  "			if (!ChimeraCharacter.Cast(entity))"\
  "				continue;"\
  "			"\
  "			if (!entity.FindComponent(FactionAffiliationComponent))"\
  "				continue;"\
  "			"\
  "			switch (FactionAffiliationComponent.Cast(entity.FindComponent(FactionAffiliationComponent)).GetAffiliatedFactionKey())"\
  "			{"\
  "				case m_sAttackKey:"\
  "				attackerCount++;"\
  "				break;"\
  "				case m_sDefenderKey:"\
  "				defenderCount++;"\
  "				break;"\
  "			}"\
  "		}"\
  "		"\
  "		if (attackerCount == 0)"\
  "			return;"\
  "		"\
  "		if (attackerCount > 0 && defenderCount == 0)"\
  "		{"\
  "			PhaseWin();"\
  "			return;"\
  "		}"\
  "		"\
  "		if (attackerCount == 0 && defenderCount == 0)"\
  "			return;"\
  "		"\
  "		if ((defenderCount / attackerCount) <= percentToWin)"\
  "			PhaseWin();"\
  "	"
 }
 Zone2 {
  coords 9813.052 56.215 9475.448
  userScript "	string m_sAttackKey = \"BLUFOR\";"\
  "	string m_sDefenderKey = \"OPFOR\";"\
  "	float percentToWin = 0.50;"\
  "	"\
  "	void PhaseWin()"\
  "	{"\
  "		SCR_PopUpNotification.GetInstance().PopupMsg(\"OBJ Ruby is under our control!\", 10, \"Continue mission to the next objective!\");"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 100
  PeriodicQueries 1
  UpdatePeriod 10
  OnQueryFinished ""\
  "		QueryEntitiesInside();"\
  "		array<IEntity> entities = {};"\
  "		GetEntitiesInside(entities);"\
  "		int attackerCount = 0;"\
  "		int defenderCount = 0;"\
  "		foreach (IEntity entity: entities)"\
  "		{"\
  "			if (!ChimeraCharacter.Cast(entity))"\
  "				continue;"\
  "			"\
  "			if (!entity.FindComponent(FactionAffiliationComponent))"\
  "				continue;"\
  "			"\
  "			switch (FactionAffiliationComponent.Cast(entity.FindComponent(FactionAffiliationComponent)).GetAffiliatedFactionKey())"\
  "			{"\
  "				case m_sAttackKey:"\
  "				attackerCount++;"\
  "				break;"\
  "				case m_sDefenderKey:"\
  "				defenderCount++;"\
  "				break;"\
  "			}"\
  "		}"\
  "		"\
  "		if (attackerCount == 0)"\
  "			return;"\
  "		"\
  "		if (attackerCount > 0 && defenderCount == 0)"\
  "		{"\
  "			PhaseWin();"\
  "			return;"\
  "		}"\
  "		"\
  "		if (attackerCount == 0 && defenderCount == 0)"\
  "			return;"\
  "		"\
  "		if ((defenderCount / attackerCount) <= percentToWin)"\
  "			PhaseWin();"\
  "	"
 }
 BTR {
  coords 10370.024 60.356 9936.619
  userScript "	IEntity m_BTR;"\
  "	bool m_bBTRHasBeenSet = false;"\
  "	ResourceName m_sPrefabeToLookFor = \"{C012BB3488BEA0C2}Prefabs/Vehicles/Wheeled/BTR70/BTR70.et\";"\
  "	"\
  "	void PhaseWin()"\
  "	{"\
  "		SCR_PopUpNotification.GetInstance().PopupMsg(\"OBJ Platinum has been destroyed!\", 10, \"Push the FIA off this Island!\");"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 20.6
  DrawShape 1
  PeriodicQueries 1
  UpdatePeriod 5
  OnQueryFinished ""\
  "		if (!m_BTR)"\
  "		{"\
  "			QueryEntitiesInside();"\
  "			array<IEntity> entities = {};"\
  "			GetEntitiesInside(entities);"\
  "			"\
  "			foreach (IEntity entity: entities)"\
  "			{"\
  "				if (!Vehicle.Cast(entity))"\
  "					continue;"\
  "				"\
  "				if (entity.GetPrefabData().GetPrefabName() == m_sPrefabeToLookFor)"\
  "				{"\
  "					m_BTR = entity;"\
  "					m_bBTRHasBeenSet = true;"\
  "				}"\
  "					"\
  "			}"\
  "		}"\
  "		"\
  "		if (!m_bBTRHasBeenSet)"\
  "			return;"\
  "		"\
  "		if (!m_BTR)"\
  "			PhaseWin();"\
  "		"\
  "		SCR_WheeledDamageManagerComponent damageMan = SCR_WheeledDamageManagerComponent.Cast(m_BTR.FindComponent(SCR_WheeledDamageManagerComponent));"\
  "		if (damageMan.GetDefaultHitZone().GetDamageState() == EDamageState.DESTROYED)"\
  "			PhaseWin();"\
  "	"
 }
 AirRaid1 {
  coords 10039.78 58.342 9614.523
  EOnInit ""\
  "		#ifdef WORKBENCH"\
  "		CRF_Gamemode.GetInstance().m_aAirRaidLocations.Insert(owner.GetOrigin());"\
  "		#else"\
  "		if (!System.IsConsoleApp())"\
  "			return;"\
  "		"\
  "		CRF_Gamemode.GetInstance().m_aAirRaidLocations.Insert(owner.GetOrigin());"\
  "		#endif"\
  "	"
 }
 AirRaid2 {
  coords 10129.852 176.725 10309.965
  EOnInit ""\
  "		#ifdef WORKBENCH"\
  "		CRF_Gamemode.GetInstance().m_aAirRaidLocations.Insert(owner.GetOrigin());"\
  "		#else"\
  "		if (!System.IsConsoleApp())"\
  "			return;"\
  "		"\
  "		CRF_Gamemode.GetInstance().m_aAirRaidLocations.Insert(owner.GetOrigin());"\
  "		#endif"\
  "	"
 }
}
