 BTR {
  coords 4765.199 74.794 6094.954
  userScript "	IEntity m_BTR;"\
  "	bool m_bBTRHasBeenSet = false;"\
  "	ResourceName m_sPrefabeToLookFor = \"{E97CDE3AED048BF6}Prefabs/Vehicles/CCO21/EG_BTR.et\";"\
  "	"\
  "	void PhaseWin()"\
  "	{"\
  "		CRF_RplBroadcastManager.GetInstance().PopUpNotification(10, \"The East German Screen has been routed!\", \"Continue mission and capture The Ruha Bridge!\", \"{E3E34E1B0BC94432}Sounds/UI/Samples/Menu/UI_Task_Succeded.wav\");"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 10
  PeriodicQueries 1
  UpdatePeriod 10
  OnQueryFinished ""\
  "		#ifdef WORKBENCH"\
  "		#else"\
  "		if (!System.IsConsoleApp())"\
  "			return;"\
  "		#endif"\
  "		"\
  "		if (!m_BTR)"\
  "		{"\
  "			QueryEntitiesInside();"\
  "			array<IEntity> entities = {};"\
  "			GetEntitiesInside(entities);"\
  "			"\
  "			foreach (IEntity entity: entities)"\
  "			{"\
  "				if (!Vehicle.Cast(entity))"\
  "					continue;"\
  "				"\
  "				if (entity.GetPrefabData().GetPrefabName() == m_sPrefabeToLookFor)"\
  "				{"\
  "					m_BTR = entity;"\
  "					m_bBTRHasBeenSet = true;"\
  "				}"\
  "					"\
  "			}"\
  "		}"\
  "		"\
  "		if (!m_bBTRHasBeenSet)"\
  "			return;"\
  "		"\
  "		if (!m_BTR)"\
  "			PhaseWin();"\
  "		"\
  "		SCR_WheeledDamageManagerComponent damageMan = SCR_WheeledDamageManagerComponent.Cast(m_BTR.FindComponent(SCR_WheeledDamageManagerComponent));"\
  "		if (damageMan.GetDefaultHitZone().GetDamageState() == EDamageState.DESTROYED)"\
  "			PhaseWin();"\
  "	"
 }
