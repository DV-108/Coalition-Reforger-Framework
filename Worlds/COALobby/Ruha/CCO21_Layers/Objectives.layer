$grp BaseGameTriggerEntity {
 SouthAirfieldZone {
  coords 6637.6 96.719 1179.115
  userScript "	string m_sAttackKey = \"BLUFOR\";"\
  "	string m_sDefenderKey = \"OPFOR\";"\
  "	string m_sSecondDefenderKey = \"INDFOR\";"\
  "	float percentToWin = 0.35;"\
  "	"\
  "	void PhaseWin()"\
  "	{"\
  "		CRF_RplBroadcastManager.GetInstance().PopUpNotification(10, \"The Southern Half of the Airfield has been captured!\", \"\", \"{E3E34E1B0BC94432}Sounds/UI/Samples/Menu/UI_Task_Succeded.wav\");"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 137.4
  PeriodicQueries 1
  UpdatePeriod 10
  OnQueryFinished ""\
  "		#ifdef WORKBENCH"\
  "		#else"\
  "		if (!System.IsConsoleApp())"\
  "			return;"\
  "		#endif"\
  "		QueryEntitiesInside();"\
  "		array<IEntity> entities = {};"\
  "		GetEntitiesInside(entities);"\
  "		int attackerCount = 0;"\
  "		int defenderCount = 0;"\
  "		foreach (IEntity entity: entities)"\
  "		{"\
  "			if (!ChimeraCharacter.Cast(entity))"\
  "				continue;"\
  "			"\
  "			if (!entity.FindComponent(FactionAffiliationComponent))"\
  "				continue;"\
  "			"\
  "			switch (FactionAffiliationComponent.Cast(entity.FindComponent(FactionAffiliationComponent)).GetAffiliatedFactionKey())"\
  "			{"\
  "				case m_sAttackKey:"\
  "				attackerCount++;"\
  "				break;"\
  "				case m_sDefenderKey:"\
  "				defenderCount++;"\
  "				break;"\
  "				case m_sSecondDefenderKey:"\
  "				defenderCount++;"\
  "				break;"\
  "			}"\
  "		}"\
  "		"\
  "		if (attackerCount == 0)"\
  "			return;"\
  "		"\
  "		if (attackerCount > 0 && defenderCount == 0)"\
  "		{"\
  "			PhaseWin();"\
  "			return;"\
  "		}"\
  "		"\
  "		if (attackerCount == 0 && defenderCount == 0)"\
  "			return;"\
  "		"\
  "		if ((defenderCount / attackerCount) <= percentToWin)"\
  "			PhaseWin();"\
  "	"
 }
